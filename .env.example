# Copy this file to .env and adjust if your local PostgreSQL setup differs
# from the default. scripts/run_pipeline.py, scripts/ingest_raw.py, and
# tests/test_data_quality.py all read OLIST_DB_URL if it's set, falling back
# to the default below otherwise.

OLIST_DB_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5433/olist