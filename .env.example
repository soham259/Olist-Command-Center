# Copy this file to .env (same folder) and set your own password.
# scripts/config.py reads OLIST_DB_URL from the environment first, then from
# .env, then falls back to the default below. Never commit .env (it is
# gitignored).
#
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
# 5432 is PostgreSQL's standard port; change it only if your installer chose
# another one (e.g. 5433 when a second PostgreSQL version is installed).
#
# WARNING: the pipeline drops and recreates the `raw` and `analytics` schemas
# in this database — point it at a dedicated project database.

OLIST_DB_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/olist
